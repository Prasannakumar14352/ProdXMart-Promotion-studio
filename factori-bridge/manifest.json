{
  "manifest_version": 3,
  "name": "ProdXMart product importer",
  "version": "1.1.1",
  "description": "Open a product from your Factori retailer catalogue in your local Promotion Studio.",
  "content_scripts": [
    {
      "matches": [
        "https://retailing.factori.com/*"
      ],
      "js": [
        "pricing.js",
        "products.js"
      ]
    }
  ],
  "action": {
    "default_title": "Import to ProdXMart Studio",
    "default_popup": "popup.html"
  }
}
