{
  "manifest_version": 3,
  "name": "ProdXMart product importer",
  "version": "1.3.0",
  "description": "Open a product from your Factori retailer catalogue in your local Promotion Studio.",
  "content_scripts": [
    {
      "matches": [
        "https://retailing.factori.com/*"
      ],
      "js": [
        "fields.js",
        "pricing.js",
        "pagination.js",
        "products.js"
      ]
    },
    {
      "matches": [
        "https://prodxmart.com/*",
        "https://www.prodxmart.com/*"
      ],
      "js": [
        "fields.js",
        "storefront.js"
      ]
    },
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "local.js"
      ]
    }
  ],
  "action": {
    "default_title": "Import to ProdXMart Studio",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "host_permissions": [
    "https://cdn.factori.com/*",
    "https://prodxmart.com/*",
    "https://www.prodxmart.com/*"
  ]
}
